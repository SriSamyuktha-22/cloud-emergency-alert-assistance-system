PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173

# Leave USE_AWS=false for local demo mode.
USE_AWS=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

USERS_TABLE=EmergencyUsers
CONTACTS_TABLE=EmergencyContacts
ALERTS_TABLE=EmergencyAlerts

# SNS SMS sender identity is optional. Leave empty for default account configuration.
SNS_SMS_SENDER_ID=

# SES is optional. Example: verified@yourdomain.com
SES_FROM_EMAIL=
